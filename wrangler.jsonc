{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apranntech-sc",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apranntech-db",
      "database_id": "5f46bd0a-da83-482b-a913-44265b34e908"
    }
  ]
}
